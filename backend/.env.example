# ══════════════════════════════════════════════════════════
#  Zenith Ticketing — Backend Environment Variables
#  Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────
# Local Docker:
DATABASE_URL=postgresql://ticketing_user:ticketing_password@localhost:5432/ticketing_app
# Neon / Supabase / RDS:
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# DB connection pool (optional, defaults shown)
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000

# ── Server ────────────────────────────────────────────────
BACKEND_PORT=5000
NODE_ENV=development
# MUST be a strong random string in production (min 32 chars)
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars

# ── CORS ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── GitHub Issues integration (optional) ─────────────────
# Token needs: repo scope (for issues) + project scope (for project board)
# Use a Classic PAT — fine-grained PATs do NOT support Projects V2
GITHUB_TOKEN=
GITHUB_ISSUE_OWNER=your-github-username-or-org
GITHUB_ISSUE_REPO=your-repo-name

# ── GitHub Projects V2 (optional, for status sync) ───────
# The number from your project URL: github.com/orgs/ORG/projects/NUMBER
GITHUB_PROJECT_NUMBER=
# 'org' (default) or 'user'
GITHUB_PROJECT_OWNER_TYPE=org

# ── GitHub Webhook secret (optional but recommended) ─────
# Set this on your GitHub webhook settings AND here
GITHUB_WEBHOOK_SECRET=

# ── GitHub image storage (optional — uses local disk when unset) ──
GITHUB_BRANCH=main
GITHUB_UPLOAD_PATH=tickets

# ── Email / SMTP (optional) ───────────────────────────────
# If unset, dev mode uses Ethereal (fake inbox, check console for URL)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ── Docker Compose (optional) ────────────────────────────
POSTGRES_USER=ticketing_user
POSTGRES_PASSWORD=ticketing_password
POSTGRES_DB=ticketing_app
