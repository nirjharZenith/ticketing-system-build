# PostgreSQL connection string
# Local Docker: postgresql://ticketing_user:ticketing_password@localhost:5432/ticketing_app
DATABASE_URL=postgresql://ticketing_user:ticketing_password@localhost:5432/ticketing_app

# Server
BACKEND_PORT=5000
NODE_ENV=development
JWT_SECRET=change-this-to-a-secure-random-string

# CORS
FRONTEND_URL=http://localhost:3000

# Image storage — leave GitHub vars empty to use local disk storage
STORAGE_PROVIDER=local
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_UPLOAD_PATH=tickets

# Email (optional — uses Ethereal in dev if unset)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
